{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "Miak Tech — Agent Overview",
  "uid": "miak-tech-agents",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Budget Used per Agent ($)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.5 }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_used [10m]) by (agent)",
          "legendFormat": "{{agent}}",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 2,
      "title": "Budget Remaining per Agent ($)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1.0 }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_remaining [10m]) by (agent)",
          "legendFormat": "{{agent}}",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "title": "Budget Used Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 6,
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_used [1m]) by (agent)",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Budget Used (all agents)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_used [10m]) by (agent))",
          "legendFormat": "Total Used",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Budget Remaining",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_remaining [10m]) by (agent))",
          "legendFormat": "Total Remaining",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 6,
      "title": "Most Active Agent",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "topk(1, last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_used [10m]) by (agent))",
          "legendFormat": "{{agent}}",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 7,
      "title": "Overall Budget Usage %",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg(last_over_time({service=\"miak-tech\", type=\"metric\"} | json | unwrap budget_pct [10m]) by (agent))",
          "legendFormat": "Usage %",
          "instant": true,
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 8,
      "title": "Agent Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service=\"miak-tech\", type=\"log\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "title": "Logs by Agent",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 32 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service=\"miak-tech\", type=\"log\", agent=~\"$agent\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 10,
      "title": "Outgoing Messages Only",
      "type": "logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 32 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service=\"miak-tech\", type=\"log\", direction=\"outgoing\"}",
          "legendFormat": ""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({service=\"miak-tech\"}, agent)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  }
}
