# Copy to .env and fill in your values
# For local dev: source .env && iex -S mix
# For docker compose: docker compose --env-file .env up --build

OPENAI_API_KEY=sk-...
TELEGRAM_TOKEN=bot_token_from_botfather
WINDMILL_TOKEN=token_from_windmill

DB_PASSWORD=choose_a_password

GRAFANA_LOKI_URL=https://logs-prod-xxx.grafana.net
GRAFANA_LOKI_USER=numeric_user_id
GRAFANA_API_KEY=glc_...

# Optional — these are the defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oban_elixir
DB_USER=oban
